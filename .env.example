# ─────────────────────────────────────────────────────────────────────────────
# Ponkali Masalas — environment variables
# Copy this file to `.env.local` for local dev, and set the same keys in your
# Vercel project settings for production.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Supabase / PostgreSQL) ─────────────────────────────────────────
# Create a free project at https://supabase.com, then:
#   Project Settings → Database → Connection string → "Transaction pooler"
# Copy that URI here and replace [YOUR-PASSWORD] with your database password.
# The Transaction pooler (port 6543) is what Vercel/serverless should use.
# Use the SAME value locally and in Vercel's Environment Variables.
Database_url
# ── Admin login (REQUIRED in production) ─────────────────────────────────────
# In production, admin login is DISABLED until ADMIN_PASSWORD and
# ADMIN_SESSION_SECRET are both set — the app fails closed rather than using a
# public default. ADMIN_USERNAME is optional (defaults to "ponkali_admin").
ADMIN_USERNAME=
ADMIN_PASSWORD=change_me_to_a_strong_admin_password

# ── Session secrets (CHANGE THESE before going live) ─────────────────────────
# Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=change_me_to_a_long_random_string
SESSION_SECRET=change_me_to_a_different_long_random_string

# ── Email (Resend) — for contact + order confirmation emails ─────────────────
# Sign up at https://resend.com and create an API key. Without RESEND_API_KEY,
# emails are skipped (logged) and the rest of the site keeps working.
RESEND_API_KEY=
# "From" address. Use the onboarding sender until you verify your own domain in
# Resend; afterwards switch to your domain, e.g. "Ponkali Masalas <orders@ponkali.in>".
EMAIL_FROM=Ponkali Masalas <onboarding@resend.dev>
# Where new-order and contact-message notifications are delivered.
BUSINESS_EMAIL=ponkaliturmeric@gmail.com

# ── WhatsApp order confirmation (Meta WhatsApp Cloud API) — optional ─────────
# Sends the customer a WhatsApp confirmation with their order ID. FREE platform
# (no monthly fee; only Meta's small per-message charge). Without these three
# set, WhatsApp sending is skipped (logged) and orders/email keep working.
# Setup: developers.facebook.com → create an app → add "WhatsApp" → API Setup.
#   1. Copy the temporary token to test; later create a System User PERMANENT
#      token with the whatsapp_business_messaging permission.
#   2. WHATSAPP_PHONE_NUMBER_ID is the "Phone number ID" shown in API Setup
#      (NOT the phone number itself).
#   3. In WhatsApp Manager → Message Templates, create a "Utility" template for
#      order confirmation whose body has 4 variables in order: {{1}} name,
#      {{2}} order id, {{3}} total, {{4}} status. Put its name below.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
# Optional — template language code (default "en") and Graph API version (default "v21.0").
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_GRAPH_VERSION=v21.0

# ── Payments (Razorpay) — optional; without these, only Cash on Delivery works ─
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=

# ── Site / analytics ─────────────────────────────────────────────────────────
# Use the SAME canonical host Google indexes (www) and make it your primary
# domain in Vercel so the other variant 301-redirects to it.
NEXT_PUBLIC_SITE_URL=https://www.ponkali.in

