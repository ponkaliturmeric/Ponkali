# ─────────────────────────────────────────────────────────────
# Ponkali Masalas — environment variables
# Copy to .env.local (gitignored) and fill in real values.
# ─────────────────────────────────────────────────────────────

# Public site URL — used for canonical URLs, sitemap, robots, Open Graph.
NEXT_PUBLIC_SITE_URL=https://ponkali.in

# ── SEO measurement (optional; features load only when set) ──
# Google Search Console verification token (Settings → Ownership → HTML tag → content="...").
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
NEXT_PUBLIC_GA_ID=

# Database (Turso / libSQL). Required in production; locally falls back to
# a file DB at ./database/local.db when these are unset.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Session secrets — MUST be set to long random strings in production.
SESSION_SECRET=change-me-customer-session-secret
ADMIN_SESSION_SECRET=change-me-admin-session-secret

# ── Razorpay payments ──
# Get keys from https://dashboard.razorpay.com → Settings → API Keys.
# Use rzp_test_* keys for development, rzp_live_* in production.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Optional: set when you configure the webhook in the Razorpay dashboard
# (Settings → Webhooks → point at /api/razorpay/webhook).
RAZORPAY_WEBHOOK_SECRET=
